# /etc/caddy-visualizer/env   (mode 0640, owner root:caddymgr)
# One KEY=value per line, no quotes, no `export`.

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Listen on loopback only; Caddy fronts it over HTTPS (see Caddyfile.snippet).
HOSTNAME=127.0.0.1
PORT=3000

# false = Secure cookies, which need HTTPS (or http://localhost through an SSH tunnel).
ALLOW_INSECURE_LAN_HTTP=false

DATABASE_PATH=/var/lib/caddy-visualizer/data/caddy-visualizer.db

# First start only. After the first login remove the next line, THEN delete the file
# (a missing file with the line still set makes the service refuse to start).
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD_FILE=/etc/caddy-visualizer/initial-password

# Paths shared with Caddy. They must be the same ones Caddy itself sees.
CADDY_ADMIN_URL=unix:///run/caddy-admin/admin.sock
CADDY_MAIN_CADDYFILE=/etc/caddy/Caddyfile
CADDY_MANAGED_DIR=/var/lib/caddy-visualizer/managed
CADDY_ACCESS_LOG_FILE=/var/log/caddy/access.log

# ---- Optional, new in 1.5/1.6. Both are off by default; leave them unset. ------------
# DO NOT set AUTH_DISABLED=true here. It turns the built-in login off and is only for a setup
# where an authenticating reverse proxy sits in front of the app. This install has none, and
# BIND_ADDRESS (which the app uses to refuse that mistake) is only passed in by the Docker
# compose file, so nothing would stop the app from running without a login.
# AUTH_DISABLED=false
#
# Certificate checks (Certificates page) connect to the host names Caddy serves, over TLS on 443.
# Names that resolve to private addresses are skipped unless listed here (comma separated,
# subdomains included, no wildcards). Not needed for a wildcard-only Caddyfile: wildcard names
# are never probed.
# CERT_CHECK_PRIVATE_DOMAINS=

# Your time zone (the upstream example uses Europe/Berlin).
TZ=UTC
